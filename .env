# ==========================================
# Real-Time Order & Delivery Platform Configuration
# ==========================================

# Go Order Service
ORDER_SERVICE_PORT=8080
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/order_platform_db?sslmode=disable
ORDER_SERVICE_KAFKA_BROKERS=localhost:9092
ORDER_KAFKA_TOPIC=order.created

# Node.js Delivery Service
DELIVERY_SERVICE_PORT=5000
REDIS_URL=redis://localhost:6379
DELIVERY_KAFKA_BROKERS=localhost:9092
DELIVERY_KAFKA_GROUP_ID=delivery-service-group
DELIVERY_KAFKA_TOPIC=order.created
ORDER_SERVICE_URL=http://localhost:8080

# Next.js Frontend
NEXT_PUBLIC_ORDER_API_URL=http://localhost:8080
NEXT_PUBLIC_DELIVERY_API_URL=http://localhost:5000
NEXT_PUBLIC_DELIVERY_WS_URL=ws://localhost:5000
